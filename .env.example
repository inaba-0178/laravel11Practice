# MST DB
MST_DATABASE=mst_db
MST_ROOT_PASSWORD=root_mst
MST_USER=admin
MST_PASSWORD=mst_pass
DB_MST_HOST=mst-db
DB_MST_PORT=3306

# USER DB
USER_DATABASE=user_db
USER_ROOT_PASSWORD=root_user
USER_USER=user_user
USER_PASSWORD=user_pass
DB_USER_HOST=user-db
DB_USER_PORT=3308

# MST Backup DB
MST_BACKUP_DATABASE=mst_backup_db
MST_BACKUP_ROOT_PASSWORD=root_mst_backup
MST_BACKUP_USER=admin
MST_BACKUP_PASSWORD=mst_backup_pass
DB_MST_BACKUP_HOST=mst-backup-db
DB_MST_BACKUP_PORT=3309

# Log DB
LOG_DATABASE=log_db
LOG_ROOT_PASSWORD=root_log
LOG_USER=log_user
LOG_PASSWORD=log_pass

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Laravel ファイルストレージ
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=car-images
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://localhost:9000/car-images

# redis設定
CACHE_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

TZ=Asia/Tokyo
